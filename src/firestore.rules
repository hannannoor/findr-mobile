rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      // Every report list in Findr is available only after login.
      allow read: if request.auth != null;

      // A new report must belong to the account that is creating it.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.base64Image is string
        && request.resource.data.base64Image.size() <= 700000;

      // Only the owner may edit a report. Ownership and creation details
      // cannot be transferred or rewritten during an update.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userEmail == resource.data.userEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.base64Image is string
        && request.resource.data.base64Image.size() <= 700000;

      // Only the owner may permanently remove their report.
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
