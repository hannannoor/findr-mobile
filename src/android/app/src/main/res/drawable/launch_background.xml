<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen shown while the Flutter engine starts up. The Findr mark
     and wordmark are centred on the brand colour, so the app looks like itself
     from the very first frame instead of showing a blank white window. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
